rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Invite allowlist — anyone can check if their own email is invited,
    // but the list itself cannot be enumerated and only the Firebase Console
    // / Admin SDK can add or remove entries.
    match /invites/{email} {
      allow get:   if true;   // unauthenticated check before sign-up
      allow list:  if false;  // prevents enumerating all invited emails
      allow write: if false;  // managed via Firebase Console only
    }

    // Each user can only read/write their own data, and their email must
    // appear in the invites allowlist.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email));
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
